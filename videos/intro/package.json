{
  "name": "@anglesharp/video-intro",
  "version": "1.0.0",
  "description": "An 8 minute introduction to AngleSharp.",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Introduction out/introduction.mp4",
    "still": "remotion still src/index.ts",
    "typecheck": "tsc -p .",
    "render:silent": "remotion render src/index.ts Introduction out/introduction-silent.mp4 --props={\\\"music\\\":false}",
    "music": "node ../tools/generate-music.mjs --duration 480 --out public/music.mp3"
  },
  "dependencies": {
    "@anglesharp/video-shared": "*",
    "@remotion/cli": "4.0.546",
    "@remotion/google-fonts": "4.0.546",
    "@remotion/media": "4.0.546",
    "@remotion/transitions": "4.0.546",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.546"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
